# Copy to .env (git-ignored) and edit. Real environment variables take precedence.
# Every setting is optional; the value shown is the default.
# Older EDITH_* names still work as fallbacks.
CLOCK_MODEL=qwen3.5:9b-q4_K_M
# What she calls you. Leave empty for no name.
CLOCK_USER=Snow
CLOCK_VOICE=en-GB-RyanNeural
CLOCK_WHISPER=small.en
# auto | phonon | whisper. auto uses Phonon-2 when fermion-research is installed (see requirements-phonon.txt).
CLOCK_STT=auto
# Folder the file tools may read. Default is ~/Documents.
# CLOCK_DIR=C:\Users\you\Documents
# Default city for weather.
CLOCK_CITY=New Delhi
# 0 turns off the wake-word chime.
CLOCK_CHIME=1

# wake word: openWakeWord model file, name or path (see docs/wake_word_training.md)
#CLOCK_WAKE_ENGINE=auto
#CLOCK_WAKE_MODEL=
#CLOCK_WAKE_THRESHOLD=0.5
#CLOCK_WAKE_VAD=0.5

# phone access via a private Telegram bot (docs/remote_inbox.md)
#CLOCK_TELEGRAM_TOKEN=
#CLOCK_TELEGRAM_CHAT=
# safe (default): phone cannot open apps, use clipboard/windows/screen. all: no limit.
#CLOCK_REMOTE_TOOLS=safe
